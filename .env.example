# Copy to .env and fill in. .env is gitignored (.env.example is the committed template).

# ── LiveKit Cloud (video/screen-share conference; C-RTC) ──────────────
# From your LiveKit Cloud project → Settings → Keys.
# LIVEKIT_URL is public (sent to the client). LIVEKIT_API_SECRET must stay
# server-side only — never bundle it into the client.
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_API_KEY
LIVEKIT_API_SECRET=YOUR_API_SECRET

# ── Mumble voice (optional, suggestion only) ──────────────────────────
# The DESKTOP app is the Mumble client: it connects straight to the voice server
# from the user's machine and keeps its own name, password and certificate
# locally. The server never proxies Mumble and stores no credentials for it.
# These three are only a default address the desktop Settings panel offers, so
# users don't have to type it. The browser build has no Mumble support.
# MUMBLE_HOST=mumble.example.com
# MUMBLE_PORT=64738
# MUMBLE_CHANNEL=Lobby

# ── TimeTracking (optional, suggestion only) ──────────────────────────
# The DESKTOP app is the TimeTracking client, exactly like Mumble: it talks to
# the TimeTracking server straight from the user's machine and keeps the login
# there (address + username in Electron's userData, password in the OS
# keychain). This server never proxies TimeTracking and stores no credentials
# for it — it only receives the resulting one-word status ("working", "break",
# …) so a character can show it. The browser build has no TimeTracking support.
# This is only a default address the desktop app's settings offer, so users
# don't have to type it.
# TIMETRACKING_URL=https://timetracking.example.com

# ── TLS (optional override) ───────────────────────────────────────────
# The server serves HTTPS when cert.pem + key.pem exist in the data dir
# (alongside the SQLite DB; default: tmp/data in the repo, where a dev
# certificate is generated on first start). Override the paths here,
# e.g. later for Let's Encrypt:
# PIXEL_TLS_CERT=/etc/letsencrypt/live/example.com/fullchain.pem
# PIXEL_TLS_KEY=/etc/letsencrypt/live/example.com/privkey.pem
