{
  "name": "pixel-agents",
  "version": "3.0.0",
  "private": true,
  "description": "Multi-agent pixel world rendered with Colyseus (authoritative server) + Phaser (client). A rewrite of pixel-agents.",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "repository": {
    "type": "git",
    "url": "https://codeberg.org/davrux/pixel-agents"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:server": "pnpm --filter @pixel/server run dev",
    "dev:client": "pnpm --filter @pixel/client run dev",
    "build": "pnpm --filter @pixel/client run build",
    "start": "pnpm --filter @pixel/server run start",
    "serve": "pnpm --filter @pixel/server run start",
    "check-types": "pnpm -r run check-types",
    "docker:build": "docker build -t \"${PIXEL_AGENTS_IMAGE:-davrux/pixel-agents:dev}\" .",
    "docker:push": "docker push \"${PIXEL_AGENTS_IMAGE:-davrux/pixel-agents:dev}\"",
    "docker:release": "pnpm run docker:build && pnpm run docker:push"
  }
}
