{
  "name": "@pixel/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop application for the pixel-agents web client",
  "author": "Pixel Agents",
  "desktopName": "pixel-agents.desktop",
  "type": "module",
  "main": "./src/main.ts",
  "scripts": {
    "check-types": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && pnpm run build:preload && pnpm run build:vendor",
    "build:preload": "esbuild src/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload.cjs",
    "build:vendor": "esbuild electron-updater --bundle --platform=node --format=cjs --external:electron --outfile=dist/vendor/electron-updater.cjs",
    "dev": "electron dist/main.js",
    "dist": "electron-builder",
    "test": "tsc -p tsconfig.test.json && node --test \"dist/test-build/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
