# Copy to .env in this directory and fill in. docker compose loads it on its own.
# .env is gitignored; this template is not. Keep .env chmod 600 — it holds the
# two credentials that grant admin and mint call tokens.

# ── The game server ───────────────────────────────────────────────────
# Which image to run. Pin a tag for a deployment you want to be able to roll
# back (ghcr.io/davrux/pixel-agents:v1.2.3); :latest follows master.
GHCR_IMAGE=ghcr.io/davrux/pixel-agents:latest

# Presenting this on the register screen creates an admin account — it is the
# ONLY way to make the first local user, and it stays the break-glass path if
# single sign-on is configured and then breaks. Generate, don't invent:
#   openssl rand -hex 32
PIXEL_ADMIN_TOKEN=

# ── LiveKit ───────────────────────────────────────────────────────────
# One key pair, used on BOTH sides: the server signs call tokens with it, the
# LiveKit container verifies them. They must match or every call fails with an
# invalid token and no useful error. LiveKit refuses to start with a secret
# shorter than 32 characters, so generate rather than invent:
#   openssl rand -hex 16     # key
#   openssl rand -hex 32     # secret (64 chars, comfortably over the minimum)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Public — this one is sent to the browser, so it is the hostname a client can
# actually reach. Must match the livekit.example.com SNI route in caddy.yaml.
LIVEKIT_URL=wss://livekit.example.com

# ── Dangerous, leave empty ────────────────────────────────────────────
# A non-empty value empties the world at the next start — maps, zones and their
# permissions, asset overrides, sessions, saved games — keeping only the
# accounts and their personal avatars. It fires once per VALUE, so the line may
# stay once it has run; changing the value fires it again. A copy of the
# database is written into the volume first (pixel-before-reset-*.db) and no
# backup means no wipe. Afterwards push the maps back with scripts/push-zones.sh.
PIXEL_RESET_WORLD=
