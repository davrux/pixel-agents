# Reinstalled inside the image; never copy host build output or local state.
node_modules
**/node_modules
dist
client/dist
# Arcade game bundles are regenerated by `build:all` inside the image (don't ship
# stale host copies into the build context).
client/public/jsdos/bundles
**/*.log
data
# Keep tmp out of the build context — EXCEPT the licensed Doom WADs, which the
# arcade bundle builder packages at build time (see build-shareware-bundles.mjs).
tmp/*
!tmp/doom-wads

# VCS + tooling
.git
.gitignore
.agent-shell
.claude

# Large raw tileset packs kept locally but unused by the app (see .gitignore).
MetroCity
Modern_Interiors_Free
moderninteriors

.DS_Store
Thumbs.db
