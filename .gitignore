node_modules/
dist/
client/dist/
# Electron packaging output (electron-builder writes the AppImage here).
release/
desktop/release/
*.tsbuildinfo
tmp/

*.log
data/

# Environment files
.env*
!.env.example

.agent-shell/
# Local agent config stays out of the repo, but shared skills are versioned.
# Memory lives in .claude/memory/ (gitignored — local only, not committed).
.claude/*
!.claude/skills/

.DS_Store
Thumbs.db

# Unused LimeZu asset packs kept locally (an earlier iteration). Not used by the
# app anymore — the office uses the original pixel-agents assets in assets/.
/Modern_Interiors_Free/
/MetroCity/
/moderninteriors/
tmp/

# Generated at release time (pnpm release / docker:build) — server logs it.
server/version.txt

# Arcade game bundles — large (~80 MB) and reproducible via
# scripts/build-arcade-bundles.mjs (Freedoom IWADs + a free DOS engine).
client/public/jsdos/bundles/

# Self-hosted EmulatorJS engine + cores — large, vendored via
# scripts/vendor-emulatorjs.mjs (not committed).
client/public/emulatorjs/

# Self-hosted MediaPipe segmentation (conference background filters) — ~19 MB of
# WASM + the selfie-segmenter model, vendored via scripts/vendor-mediapipe.mjs.
client/public/mediapipe/

# Zone maps ARE versioned (assets/tiled/zones/*.tmj) — levels are diffable, have
# a history and can be handed to someone else. That is orthogonal to how a map
# reaches a server: only a push does that (scripts/push-zones.sh); nothing reads
# these files at runtime. Only the scratch copies stay out — a *-noimport.tmj is
# somebody's experiment, never imported by anything.
assets/tiled/zones/*-noimport.tmj

# Tiled's own per-user editor state (open files, scroll position, zoom) —
# like a .vscode/settings.json, not project content.
assets/tiled/*.tiled-session

